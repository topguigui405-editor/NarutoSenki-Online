+	return duration_cast<duration<double>>(steady_clock::now().time_since_epoch()).count();
+}
+
+Group groupOfTeam(int team) { return team == 0 ? Group::Konoha : Group::Akatsuki; }
+
+bool canAct(State s) { return s == State::IDLE || s == State::WALK || s == State::NATTACK; }
+
+float dist(const Vec2 &a, float x, float y)
+{
+	float dx = x - a.x, dy = y - a.y;
+	return std::sqrt(dx * dx + dy * dy);
+}
