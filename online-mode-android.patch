+#include "Online/OnlineLobbyLayer.h"
+#include "Online/OnlineBattle.h"
+#include "Online/OnlinePump.h"
+#include "StartMenu.h"
+#include <algorithm>
+#include <cctype>
+#include <set>
+
+using online::Client;
+
+namespace
+{
+
+const char *kFont = "Arial";
+const ccColor3B kWhite = ccc3(255, 255, 255);
+const ccColor3B kYellow = ccc3(255, 214, 64);
+const ccColor3B kGray = ccc3(150, 150, 160);
+const ccColor3B kRed = ccc3(255, 120, 120);
+const ccColor3B kGreen = ccc3(130, 235, 130);
+const ccColor3B kBlue = ccc3(120, 200, 255);
+
+std::string errText(const std::string &code)
+{
+	if (code == "NO_ROOM")
+		return "Sala não encontrada. Confira o código.";
+	if (code == "FULL")
+		return "Essa sala está cheia.";
+	if (code == "STARTED")
+		return "A partida dessa sala já começou.";
+	if (code == "HERO_TAKEN")
+		return "Esse herói já foi escolhido por outro jogador.";
+	if (code == "NOT_READY")
+		return "Ainda tem jogador que não está pronto.";
+	if (code == "NOT_HOST")
+		return "Só o dono da sala pode iniciar.";
+	if (code == "TEAM_FULL")
+		return "O outro time está cheio.";
+	if (code == "SERVER_FULL")
+		return "O servidor está lotado. Tente mais tarde.";
+	if (code == "NEED_PLAYERS")
+		return "É preciso mais de um jogador para iniciar.";
+	return "Erro do servidor: " + code;
+}
+
+std::string disconnectText(const std::string &reason)
+{
+	if (reason == "dns")
+		return "Não encontrei o servidor. Confira o endereço.";
+	if (reason == "refused")
+		return "Conexão recusada. Confira IP, porta e firewall.";
+	if (reason == "timeout")
+		return "Tempo esgotado ao conectar.";
+	if (reason == "PROTO")
+		return "Versão do servidor incompatível com este jogo.";
+	if (reason == "server_closed" || reason == "closed")
+		return "Conexão encerrada pelo servidor.";
+	return "Conexão perdida (" + reason + ").";
+}
+
+std::string cleanNick(const std::string &in)
+{
+	std::string out;
+	for (char c : in)
+		if (std::isalnum((unsigned char)c) || c == '_')
+			out += c;
+	if (out.size() > 12)
+		out.resize(12);
+	return out.empty() ? "Ninja" : out;
+}
+
+std::string trim(const std::string &s)
+{
+	size_t a = s.find_first_not_of(" \t");
+	size_t b = s.find_last_not_of(" \t");
+	return a == std::string::npos ? "" : s.substr(a, b - a + 1);
+}
+
+} // namespace
+
+Scene *OnlineLobbyLayer::scene()
+{
+	auto s = Scene::create();
+	s->addChild(OnlineLobbyLayer::create());
+	return s;
+}
+
+bool OnlineLobbyLayer::init()
+{
+	if (!Layer::init())
+		return false;
+	online::ensurePump();
+
+	auto bg = LayerColor::create(ccc4(10, 14, 38, 255));
+	addChild(bg, -10);
+
+	auto ud = UserDefault::sharedUserDefault();
+	_host = ud->getStringForKey("online_host", "");
+	_nick = cleanNick(ud->getStringForKey("online_nick", "Ninja"));
+
+	float W = winSize.width, H = winSize.height;
+	_statusLabel = CCLabelTTF::create("", kFont, H / 24.0f, CCSizeMake(W * 0.94f, H * 0.1f),
+									  kCCTextAlignmentCenter, kCCVerticalTextAlignmentCenter);
+	_statusLabel->setPosition(Vec2(W / 2, H * 0.045f));
+	addChild(_statusLabel, 50);
+
+	showPage(Page::Connect);
+	return true;
+}
+
+void OnlineLobbyLayer::onEnter()
+{
+	Layer::onEnter();
+	bindClient();
+	setKeypadEnabled(true);
+	schedule(schedule_selector(OnlineLobbyLayer::autoRefreshRooms), 4.0f);
+}
+
+void OnlineLobbyLayer::onExit()
+{
+	unschedule(schedule_selector(OnlineLobbyLayer::autoRefreshRooms));
+	setKeypadEnabled(false);
+	// Se a partida está começando, quem cuida dos eventos agora é o online::Battle
+	if (!_launching)
+		Client::get().clearHandlers();
+	Layer::onExit();
+}
