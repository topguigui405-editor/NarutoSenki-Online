+// ------------------------------------------------------------------------------------------------
+// Conexão: uma thread cuida de DNS, connect, leitura e escrita. A thread principal só mexe nas filas.
+// ------------------------------------------------------------------------------------------------
+struct Client::Conn
+{
+	std::mutex mx;
+	std::deque<std::string> in; // linhas para a thread principal ("!CONNECTED", "!CLOSED motivo", ...)
+	std::string out;			// bytes pendentes de envio
+	std::atomic<bool> stop{false};
+	std::string host;
+	int port = kDefaultPort;
+
+	void pushIn(const std::string &s)
+	{
+		std::lock_guard<std::mutex> lk(mx);
+		in.push_back(s);
+	}
+};
+
+namespace
+{
+
+bool sendAll(sock_t fd, const std::string &data, const std::atomic<bool> &stop)
+{
+	size_t off = 0;
+	long long deadline = nowMs() + 5000;
+	while (off < data.size())
+	{
+		if (stop)
+			return false;
+		int n = (int)::send(fd, data.data() + off, (int)(data.size() - off), MSG_NOSIGNAL);
+		if (n > 0)
+		{
+			off += (size_t)n;
+			continue;
+		}
+		if (n < 0 && interrupted())
+			continue;
+		if (n < 0 && wouldBlock())
+		{
+			if (nowMs() > deadline)
+				return false;
+			waitSock(fd, false, 100);
+			continue;
+		}
+		return false;
+	}
+	return true;
+}
+
+void ioMain(std::shared_ptr<Client::Conn> c)
+{
+	// 1) DNS + connect (com limite de 8 s)
+	addrinfo hints;
+	memset(&hints, 0, sizeof(hints));
+	hints.ai_family = AF_UNSPEC;
+	hints.ai_socktype = SOCK_STREAM;
+	addrinfo *res = nullptr;
+	std::string portStr = std::to_string(c->port);
+	if (getaddrinfo(c->host.c_str(), portStr.c_str(), &hints, &res) != 0 || !res)
+	{
+		if (!c->stop)
+			c->pushIn("!FAIL dns");
+		return;
+	}
+
+	sock_t fd = kInvalidSock;
+	long long deadline = nowMs() + 8000;
+	for (addrinfo *ai = res; ai && fd == kInvalidSock && !c->stop; ai = ai->ai_next)
+	{
+		sock_t s = ::socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);
+		if (s == kInvalidSock)
+			continue;
+		setNonBlocking(s);
+		bool ok = false;
+		int r = ::connect(s, ai->ai_addr, (int)ai->ai_addrlen);
+		if (r == 0)
+		{
+			ok = true;
+		}
+		else if (inProgress() || interrupted())
+		{
+			while (!c->stop && nowMs() < deadline)
+			{
+				int pr = waitSock(s, false, 100);
+				if (pr > 0)
+				{
+					int err = 0;
+					socklen_t_ len = sizeof(err);
+					getsockopt(s, SOL_SOCKET, SO_ERROR, (char *)&err, &len);
+					ok = (err == 0);
+					break;
+				}
+				if (pr < 0)
+					break;
+			}
+		}
+		if (ok)
+			fd = s;
+		else
+			closeSock(s);
+	}
+	freeaddrinfo(res);
+
+	if (fd == kInvalidSock)
+	{
+		if (!c->stop)
+			c->pushIn(nowMs() >= deadline ? "!FAIL timeout" : "!FAIL refused");
+		return;
+	}
+
+	int one = 1;
+	setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, (const char *)&one, sizeof(one));
+#ifdef SO_NOSIGPIPE
+	setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, (const char *)&one, sizeof(one));
+#endif
+	c->pushIn("!CONNECTED");
+
+	// 2) laço de leitura/escrita
+	std::string rbuf;
+	char tmp[4096];
+	long long nextPing = nowMs() + 10000;
+	std::string closeReason = "closed";
+	while (!c->stop)
+	{
+		int pr = waitSock(fd, true, 15);
+		if (pr < 0)
+		{
+			closeReason = "error";
+			break;
+		}
+		if (pr > 0)
+		{
+			int n = (int)::recv(fd, tmp, sizeof(tmp), 0);
+			if (n > 0)
+			{
+				rbuf.append(tmp, (size_t)n);
+				size_t pos;
+				while ((pos = rbuf.find('\n')) != std::string::npos)
+				{
+					std::string line = rbuf.substr(0, pos);
+					rbuf.erase(0, pos + 1);
+					if (!line.empty() && line.back() == '\r')
+						line.pop_back();
+					if (!line.empty())
+						c->pushIn(line);
+				}
+				if (rbuf.size() > 8192)
+				{
+					closeReason = "overflow";
+					break;
+				}
+			}
+			else if (n == 0)
+			{
+				closeReason = "server_closed";
+				break;
+			}
+			else if (!wouldBlock() && !interrupted())
+			{
+				closeReason = "error";
+				break;
+			}
+		}
+
+		long long now = nowMs();
+		if (now >= nextPing)
+		{
+			nextPing = now + 10000;
+			std::lock_guard<std::mutex> lk(c->mx);
+			c->out += "PING " + std::to_string(now & 0x7fffffff) + "\n";
+		}
+
+		std::string data;
+		{
+			std::lock_guard<std::mutex> lk(c->mx);
+			data.swap(c->out);
+		}
+		if (!data.empty() && !sendAll(fd, data, c->stop))
+		{
+			closeReason = "send_failed";
+			break;
+		}
+	}
+
+	closeSock(fd);
+	if (!c->stop)
+		c->pushIn("!CLOSED " + closeReason);
+}
+
+} // namespace
