+// ------------------------------------------------------------------------------------------------
+// Interface
+// ------------------------------------------------------------------------------------------------
+CCMenuItem *OnlineLobbyLayer::addButton(const std::string &text, float cx, float cy, float w, float h,
+										SEL_MenuHandler sel, int tag, bool enabled, bool primary)
+{
+	return addButtonTo(_menu, text, cx, cy, w, h, sel, tag, enabled, primary);
+}
+
+CCMenuItem *OnlineLobbyLayer::addButtonTo(CCMenu *menu, const std::string &text, float cx, float cy, float w,
+										  float h, SEL_MenuHandler sel, int tag, bool enabled, bool primary)
+{
+	float H = winSize.height;
+	float chars = (float)std::max<size_t>(text.size(), 6);
+	float fs = std::min(H / 24.0f, w / (chars * 0.62f));
+	auto label = CCLabelTTF::create(text.c_str(), kFont, fs, CCSizeMake(w, h), kCCTextAlignmentCenter,
+									kCCVerticalTextAlignmentCenter);
+	label->setColor(enabled ? kWhite : kGray);
+	auto item = CCMenuItemLabel::create(label, this, sel);
+	item->setPosition(Vec2(cx, cy));
+	item->setTag(tag);
+	ccColor4B color = !enabled ? ccc4(45, 45, 55, 220) : (primary ? ccc4(190, 100, 20, 240) : ccc4(40, 56, 110, 240));
+	auto bg = LayerColor::create(color, w, h);
+	item->addChild(bg, -1);
+	item->setEnabled(enabled);
+	menu->addChild(item);
+	return item;
+}
+
+CCLabelTTF *OnlineLobbyLayer::addText(const std::string &text, float x, float y, float size,
+									  const ccColor3B &color, float anchorX)
+{
+	auto label = CCLabelTTF::create(text.c_str(), kFont, size);
+	label->setColor(color);
+	label->setAnchorPoint(Vec2(anchorX, 0.5f));
+	label->setPosition(Vec2(x, y));
+	_content->addChild(label, 3);
+	return label;
+}
+
+void OnlineLobbyLayer::setStatus(const std::string &text, bool isError)
+{
+	_status = text;
+	_statusIsError = isError;
+	if (_statusLabel)
+	{
+		_statusLabel->setString(text.c_str());
+		_statusLabel->setColor(isError ? kRed : kYellow);
+	}
+}
+
+void OnlineLobbyLayer::showPage(Page page)
+{
+	_page = page;
+	if (_content)
+	{
+		_content->removeFromParentAndCleanup(true);
+		_content = nullptr;
+		_menu = nullptr;
+	}
+	_content = Node::create();
+	addChild(_content, 1);
+	_menu = CCMenu::create();
+	_menu->setPosition(CCPointZero);
+	_content->addChild(_menu, 2);
+
+	switch (page)
+	{
+	case Page::Connect:
+		buildConnect();
+		break;
+	case Page::Menu:
+		buildMenu();
+		break;
+	case Page::Room:
+		buildRoom();
+		break;
+	case Page::Heroes:
+		buildHeroes();
+		break;
+	}
+	if (_kbLayer)
+		_menu->setEnabled(false); // teclado aberto: a página fica travada por baixo
+}
+
+void OnlineLobbyLayer::buildConnect()
+{
+	float W = winSize.width, H = winSize.height, fs = H / 18.0f;
+	addText("JOGO ONLINE", W / 2, H - H * 0.1f, H / 11.0f, kYellow);
+
+	addText("Servidor:", W * 0.06f, H * 0.66f, fs, kWhite, 0);
+	addText(_host.empty() ? "(toque em Editar e digite o IP)" : _host, W * 0.27f, H * 0.66f, fs,
+			_host.empty() ? kGray : kGreen, 0);
+	addButton("Editar", W * 0.9f, H * 0.66f, W * 0.15f, H * 0.095f, menu_selector(OnlineLobbyLayer::onEditServer));
+
+	addText("Apelido:", W * 0.06f, H * 0.50f, fs, kWhite, 0);
