+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#pragma comment(lib, "ws2_32.lib")
+typedef SOCKET sock_t;
+typedef int socklen_t_;
+static const sock_t kInvalidSock = INVALID_SOCKET;
+#else
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <unistd.h>
+typedef int sock_t;
+typedef socklen_t socklen_t_;
+static const sock_t kInvalidSock = -1;
+#endif
+
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#endif
+
+namespace online
+{
+
+namespace
+{
+
+long long nowMs()
+{
+	using namespace std::chrono;
+	return duration_cast<milliseconds>(steady_clock::now().time_since_epoch()).count();
+}
+
+#ifdef _WIN32
+struct WsaInit
+{
+	WsaInit()
+	{
+		WSADATA d;
+		WSAStartup(MAKEWORD(2, 2), &d);
+	}
+} s_wsaInit;
+void closeSock(sock_t s) { closesocket(s); }
+void setNonBlocking(sock_t s)
+{
+	u_long m = 1;
+	ioctlsocket(s, FIONBIO, &m);
+}
+bool wouldBlock() { return WSAGetLastError() == WSAEWOULDBLOCK; }
+bool inProgress() { return WSAGetLastError() == WSAEWOULDBLOCK; }
+bool interrupted() { return false; }
+#else
+void closeSock(sock_t s) { ::close(s); }
+void setNonBlocking(sock_t s) { fcntl(s, F_SETFL, fcntl(s, F_GETFL, 0) | O_NONBLOCK); }
+bool wouldBlock() { return errno == EAGAIN || errno == EWOULDBLOCK; }
+bool inProgress() { return errno == EINPROGRESS; }
+bool interrupted() { return errno == EINTR; }
+#endif
+
+// espera o socket ficar legível (read=true) ou gravável (read=false). >0 pronto, 0 timeout, <0 erro
+int waitSock(sock_t s, bool read, int ms)
+{
+#ifndef _WIN32
+	if (s >= FD_SETSIZE)
+		return -1;
+#endif
+	fd_set fs, es;
+	FD_ZERO(&fs);
+	FD_ZERO(&es);
+	FD_SET(s, &fs);
+	FD_SET(s, &es);
+	timeval tv;
+	tv.tv_sec = ms / 1000;
+	tv.tv_usec = (ms % 1000) * 1000;
+	int r = select((int)s + 1, read ? &fs : nullptr, read ? nullptr : &fs, &es, &tv);
+	if (r > 0 && FD_ISSET(s, &es))
+		return -1;
+	return r;
+}
+
+std::string sanitizeNick(const std::string &in)
+{
+	std::string out;
+	for (char c : in)
+	{
+		if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_')
+			out += c;
+		if (out.size() >= 12)
+			break;
+	}
+	return out.empty() ? "Ninja" : out;
+}
+
+int toInt(const std::string &s, int def = 0)
+{
+	if (s.empty())
+		return def;
+	char *end = nullptr;
+	long v = strtol(s.c_str(), &end, 10);
+	return (end && *end == '\0') ? (int)v : def;
+}
+
+// Chama uma CÓPIA do callback: ele pode trocar de tela e limpar/substituir os handlers enquanto roda.
+template <class F, class... A>
+void fire(const F &f, A &&...a)
+{
+	if (f)
+	{
+		F copy = f;
+		copy(std::forward<A>(a)...);
+	}
+}
