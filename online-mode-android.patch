+
+Client::Client() {}
+
+Client::~Client()
+{
+	if (_conn)
+		_conn->stop = true; // a thread (desanexada) encerra sozinha
+}
+
+Client &Client::get()
+{
+	static Client instance;
+	return instance;
+}
+
+std::vector<std::string> Client::split(const std::string &s, char sep)
+{
+	std::vector<std::string> out;
+	size_t start = 0;
+	while (true)
+	{
+		size_t p = s.find(sep, start);
+		if (p == std::string::npos)
+		{
+			out.push_back(s.substr(start));
+			break;
+		}
+		out.push_back(s.substr(start, p - start));
+		start = p + 1;
+	}
+	return out;
+}
+
+void Client::clearHandlers()
+{
+	onConnected = nullptr;
+	onDisconnected = nullptr;
+	onError = nullptr;
+	onRooms = nullptr;
+	onJoinedRoom = nullptr;
+	onRoom = nullptr;
+	onLeftRoom = nullptr;
+	onStart = nullptr;
+	onInput = nullptr;
+	onSnapshot = nullptr;
+	onEvent = nullptr;
+	onPlayerLeft = nullptr;
+	onHostChanged = nullptr;
+	onOver = nullptr;
+}
+
+void Client::connect(const std::string &host, int port, const std::string &nick)
+{
+	teardown("", false);
+	_nick = sanitizeNick(nick);
+	_conn = std::make_shared<Conn>();
+	_conn->host = host;
+	_conn->port = port > 0 ? port : kDefaultPort;
+	_state = State::Connecting;
+	_mySlot = _hostSlot = -1;
+	_room = RoomState();
+	auto conn = _conn;
+	std::thread([conn]() { ioMain(conn); }).detach();
+}
+
+void Client::disconnect()
+{
+	teardown("", false);
+}
+
+void Client::teardown(const std::string &reason, bool notify)
+{
+	if (_conn)
+	{
+		_conn->stop = true;
+		_conn.reset();
+	}
+	bool wasOnline = _state != State::Offline;
+	_state = State::Offline;
+	_mySlot = _hostSlot = -1;
+	_room = RoomState();
+	if (notify && wasOnline)
+		fire(onDisconnected, reason);
+}
+
+void Client::send(const std::string &line)
+{
+	if (!_conn)
+		return;
+	std::lock_guard<std::mutex> lk(_conn->mx);
+	_conn->out += line;
+	_conn->out += '\n';
+}
+
+void Client::pump()
+{
+	auto conn = _conn;
+	if (!conn)
+		return;
+	std::deque<std::string> batch;
+	{
+		std::lock_guard<std::mutex> lk(conn->mx);
+		batch.swap(conn->in);
+	}
+	for (auto &line : batch)
+	{
+		if (_conn != conn)
+			break; // um callback trocou/encerrou a conexão
+		dispatch(line);
+	}
+}
+
+// ---- comandos ----
+void Client::listRooms() { send("LIST"); }
+void Client::createRoom(int size) { send("CREATE " + std::to_string(size)); }
+void Client::joinRoom(const std::string &id) { send("JOIN " + id); }
+void Client::leaveRoom() { send("LEAVE"); }
+void Client::setTeam(int team) { send("TEAM " + std::to_string(team)); }
+void Client::setHero(const std::string &hero) { send("HERO " + hero); }
+void Client::setReady(bool ready) { send(ready ? "READY 1" : "READY 0"); }
+void Client::startMatch() { send("START"); }
+void Client::sendInput(char kind, int a, int b)
+{
+	if (_state != State::InBattle)
+		return;
+	send(std::string("IN ") + kind + " " + std::to_string(a) + " " + std::to_string(b));
+}
+void Client::sendSnapshot(const std::string &payload)
+{
+	if (_state == State::InBattle && isHost())
+		send("SNAP " + payload);
+}
+void Client::sendEvent(const std::string &payload)
+{
+	if (_state == State::InBattle && isHost())
+		send("EVT " + payload);
+}
+void Client::sendOver(int winnerTeam)
+{
+	if (_state == State::InBattle && isHost())
+		send("OVER " + std::to_string(winnerTeam));
+}
+void Client::quitBattle()
+{
+	if (_state == State::InBattle)
+	{
+		send("BACK");
+		_state = State::Online;
+		_mySlot = _hostSlot = -1;
+	}
+}
+
+// ---- mensagens do servidor ----
+void Client::dispatch(const std::string &line)
+{
+	if (line.empty())
+		return;
+	if (line[0] == '!')
+	{
+		if (line == "!CONNECTED")
+		{
+			send("HELLO " + std::to_string(kProtocolVersion) + " " + _nick);
+		}
+		else
+		{
+			auto f = split(line);
+			teardown(f.size() > 1 ? f[1] : "closed", true);
+		}
+		return;
+	}
+
+	auto f = split(line);
+	const std::string &cmd = f[0];
+
+	if (cmd == "WELCOME")
+	{
+		_state = State::Online;
+		fire(onConnected);
+	}
+	else if (cmd == "ERR")
+	{
+		std::string code = f.size() > 1 ? f[1] : "UNKNOWN";
+		if (code == "PROTO")
+		{
+			teardown("PROTO", true);
+			return;
+		}
+		fire(onError, code);
+	}
+	else if (cmd == "PONG")
+	{
+		int t = toInt(f.size() > 1 ? f[1] : "0");
+		int now = (int)(nowMs() & 0x7fffffff);
+		int rtt = now - t;
+		if (rtt >= 0 && rtt < 60000)
+			_pingMs = rtt;
+	}
+	else if (cmd == "ROOMS")
+	{
+		std::vector<RoomBrief> rooms;
+		for (size_t i = 2; i < f.size(); i++)
+		{
+			auto p = split(f[i], ':');
+			if (p.size() < 4)
+				continue;
+			RoomBrief b;
+			b.id = p[0];
+			b.size = toInt(p[1]);
+			b.humans = toInt(p[2]);
+			b.host = p[3];
+			rooms.push_back(b);
+		}
+		fire(onRooms, rooms);
+	}
+	else if (cmd == "JOINED" && f.size() >= 4)
+	{
+		_state = State::InRoom;
+		_room.id = f[1];
+		_mySlot = toInt(f[2], -1);
+		_room.size = toInt(f[3]);
+		fire(onJoinedRoom);
+	}
+	else if (cmd == "ROOM")
+	{
+		parseRoom(f);
+		fire(onRoom, _room);
+	}
+	else if (cmd == "LEFTROOM")
+	{
+		_state = State::Online;
+		_mySlot = _hostSlot = -1;
+		_room = RoomState();
+		fire(onLeftRoom);
+	}
+	else if (cmd == "START")
+	{
+		parseStart(f);
+	}
+	else if (cmd == "IN" && f.size() >= 5)
+	{
+		if (!f[2].empty())
+			fire(onInput, toInt(f[1], -1), f[2][0], toInt(f[3]), toInt(f[4]));
+	}
+	else if (cmd == "SNAP")
+	{
+		fire(onSnapshot, line.size() > 5 ? line.substr(5) : "");
+	}
+	else if (cmd == "EVT")
+	{
+		fire(onEvent, line.size() > 4 ? line.substr(4) : "");
+	}
+	else if (cmd == "LEFT" && f.size() >= 2)
+	{
+		fire(onPlayerLeft, toInt(f[1], -1), f.size() > 2 ? f[2] : "");
+	}
+	else if (cmd == "HOST" && f.size() >= 2)
+	{
+		_hostSlot = toInt(f[1], -1);
+		fire(onHostChanged, _hostSlot);
+	}
+	else if (cmd == "OVER" && f.size() >= 2)
+	{
+		_state = State::InRoom;
+		fire(onOver, toInt(f[1], 0));
+	}
+}
+
+void Client::parseRoom(const std::vector<std::string> &f)
+{
+	if (f.size() < 5)
+		return;
+	_room.id = f[1];
+	_room.size = toInt(f[2]);
+	_room.state = f[3];
+	_room.hostSlot = toInt(f[4], -1);
+	_hostSlot = _room.hostSlot;
+	_room.slots.clear();
+	for (size_t i = 5; i < f.size(); i++)
+	{
+		auto p = split(f[i], ':');
+		if (p.size() < 5)
+			continue;
+		SlotInfo s;
+		s.slot = toInt(p[0]);
+		s.team = toInt(p[1]);
+		s.hero = p[2];
+		s.ready = p[3] == "1";
+		s.nick = p[4];
+		s.human = (s.nick != "-" && s.nick != "COM");
+		_room.slots.push_back(s);
+	}
+}
+
+void Client::parseStart(const std::vector<std::string> &f)
+{
+	if (f.size() < 5)
+		return;
+	StartInfo info;
+	info.seed = (uint32_t)strtoul(f[1].c_str(), nullptr, 10);
+	info.size = toInt(f[2]);
+	info.hostSlot = toInt(f[3], 0);
+	for (size_t i = 4; i < f.size(); i++)
+	{
+		auto p = split(f[i], ':');
+		if (p.size() < 5)
+			continue;
+		SlotInfo s;
+		s.slot = toInt(p[0]);
+		s.team = toInt(p[1]);
+		s.hero = p[2];
+		s.human = p[3] == "1";
+		s.nick = p[4];
+		info.slots.push_back(s);
+	}
+	_hostSlot = info.hostSlot;
+	_state = State::InBattle;
+	fire(onStart, info);
+}
+
+} // namespace online
diff -ruN a/projects/NarutoSenki/Classes/Online/OnlineClient.h b/projects/NarutoSenki/Classes/Online/OnlineClient.h
--- a/projects/NarutoSenki/Classes/Online/OnlineClient.h	1970-01-01 00:00:00.000000000 +0000
+++ b/projects/NarutoSenki/Classes/Online/OnlineClient.h	2026-10-15 03:41:21.345528146 +0000
@@ -0,0 +1,149 @@
+#pragma once
+// Cliente do modo online (apenas C++ padrão + sockets; sem dependência do cocos2d-x).
+// Toda a rede roda numa thread própria; as mensagens são entregues na thread principal
+// quando alguém chama Client::pump() (feito a cada frame pelo OnlinePump).
+#include <atomic>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace online
+{
+
+constexpr int kProtocolVersion = 1;
+constexpr int kDefaultPort = 7777;
+
+struct SlotInfo
+{
+	int slot = 0;
+	int team = 0; // 0 = Konoha, 1 = Akatsuki
+	std::string hero; // "-" = ainda sem escolha
+	bool ready = false;
+	bool human = false;
+	std::string nick;
+};
+
+struct RoomState
+{
+	std::string id;
+	int size = 0; // jogadores por time (1, 3 ou 4)
+	std::string state; // "lobby" | "battle"
+	int hostSlot = -1;
+	std::vector<SlotInfo> slots;
+};
+
+struct RoomBrief
+{
+	std::string id;
+	int size = 0;
+	int humans = 0;
+	std::string host;
+};
+
+struct StartInfo
+{
+	uint32_t seed = 0;
+	int size = 0;
+	int hostSlot = 0;
+	std::vector<SlotInfo> slots; // elenco completo (humanos e IA), na ordem dos slots
+};
+
+class Client
+{
+public:
+	enum class State
+	{
+		Offline,
+		Connecting,
+		Online, // conectado e identificado, fora de sala
+		InRoom,
+		InBattle
+	};
+
+	Client();
+	~Client();
+	Client(const Client &) = delete;
+	Client &operator=(const Client &) = delete;
+
+	static Client &get(); // instância usada pelo jogo
+
+	// ---- conexão ----
+	void connect(const std::string &host, int port, const std::string &nick);
+	void disconnect();
+	State state() const { return _state; }
+	bool isConnected() const { return _state != State::Offline && _state != State::Connecting; }
+	/** Processa mensagens recebidas e dispara os callbacks. Chamar na thread principal. */
+	void pump();
+
+	// ---- lobby ----
+	void listRooms();
+	void createRoom(int size);
+	void joinRoom(const std::string &id);
+	void leaveRoom();
+	void setTeam(int team);
+	void setHero(const std::string &hero); // "RANDOM" para sorteio
+	void setReady(bool ready);
+	void startMatch(); // só o host
+
+	// ---- partida ----
+	/** kind: M=mover(x*100,y*100) R=soltar joystick A=ataque(ABType) B=soltar ataque G=usar gear S=comprar gear */
+	void sendInput(char kind, int a = 0, int b = 0);
+	void sendSnapshot(const std::string &payload); // só o host
+	void sendEvent(const std::string &payload);	   // só o host
+	void sendOver(int winnerTeam);				   // só o host
+	void quitBattle();
+
+	// ---- informação ----
+	int mySlot() const { return _mySlot; }
+	int hostSlot() const { return _hostSlot; }
+	bool isHost() const { return _mySlot >= 0 && _mySlot == _hostSlot; }
+	int pingMs() const { return _pingMs; }
+	const RoomState &room() const { return _room; }
+	const std::string &nick() const { return _nick; }
+
+	// ---- callbacks (sempre chamados dentro de pump()) ----
+	std::function<void()> onConnected;
+	std::function<void(const std::string &reason)> onDisconnected;
+	std::function<void(const std::string &code)> onError;
+	std::function<void(const std::vector<RoomBrief> &)> onRooms;
+	std::function<void()> onJoinedRoom;
+	std::function<void(const RoomState &)> onRoom;
+	std::function<void()> onLeftRoom;
+	std::function<void(const StartInfo &)> onStart;
+	std::function<void(int slot, char kind, int a, int b)> onInput;
+	std::function<void(const std::string &payload)> onSnapshot;
+	std::function<void(const std::string &payload)> onEvent;
+	std::function<void(int slot, const std::string &reason)> onPlayerLeft;
+	std::function<void(int newHostSlot)> onHostChanged;
+	std::function<void(int winnerTeam)> onOver;
+
+	void clearHandlers();
+
+	// uso interno / testes
+	static std::vector<std::string> split(const std::string &s, char sep = ' ');
+
+	struct Conn; // detalhe de implementação (thread de rede); público só para a thread poder usá-lo
+
+private:
+	void send(const std::string &line);
+	void dispatch(const std::string &line);
+	void parseRoom(const std::vector<std::string> &f);
+	void parseStart(const std::vector<std::string> &f);
+	void teardown(const std::string &reason, bool notify);
+
+	std::shared_ptr<Conn> _conn;
+	std::atomic<State> _state{State::Offline};
+	std::string _nick;
+	int _mySlot = -1;
+	int _hostSlot = -1;
+	int _pingMs = 0;
+	RoomState _room;
+	long long _lastPingMs = 0;
+};
+
+} // namespace online
